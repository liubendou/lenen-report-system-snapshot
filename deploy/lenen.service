# 乐恩报道管理系统 - Linux systemd 服务单元
# 安装步骤：
#   sudo cp deploy/lenen.service /etc/systemd/system/lenen.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lenen
[Unit]
Description=Lenen Enrollment & Reporting System (乐恩报道管理系统)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lenen
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=LENEN_DATA=/opt/lenen/data
ExecStart=/usr/bin/node /opt/lenen/server.js
Restart=always
RestartSec=3
StandardOutput=append:/opt/lenen/data/service.out.log
StandardError=append:/opt/lenen/data/service.err.log

[Install]
WantedBy=multi-user.target

